# Runtime copies of the shipped datasets, seeded from *.default.json on first
# use and reset on every side panel load: the golden answers, conversation
# scenarios and red-team probes the app edits.
backend/datasets/goldens.json
backend/datasets/conversations.json
backend/datasets/security_probes.json
backend/datasets/security_probes.latest.json
backend/datasets/deepteam_catalog.json
backend/datasets/security_probes.target_*.json

# Runtime uploads (reference documents for golden generation) and local screenshots
backend/datasets/documents/
/Images/

# Log of every golden-set write (what changed, which action), for tracing lost rows.
backend/datasets/goldens_changes.log

# Output of run-backend-service.bat (the always-on backend task).
logs/

# The user's own metrics (G-Eval / DAG), seeded from custom_metrics.default.json.
backend/datasets/custom_metrics.json

# Local stamp of the docs hook (python .claude/hooks/docs_guard.py --ack).
.claude/docs-reviewed

# Copies of every report sent to Confident AI (backend/confident_reports.py).
reports/
