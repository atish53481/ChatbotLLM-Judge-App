# Copy to .env and fill in. .env is git-ignored.
# Key for the judge model's OpenAI-compatible API (a Groq key works with the defaults
# below; for a Command Code key set JUDGE_BASE_URL=https://api.commandcode.ai/provider/v1).
JUDGE_API_KEY=
# Optional overrides:
# JUDGE_MODEL=openai/gpt-oss-120b
# JUDGE_BASE_URL=https://api.groq.com/openai/v1
# JUDGE_DB_PATH=judge.db
# JUDGE_EXTENSION_ID=<32-letter id>   # pin CORS to your installed extension
# Production settings:
# JUDGE_LOG_LEVEL=INFO                 # DEBUG, INFO, WARNING or ERROR (paths and status codes only, never bodies)
# JUDGE_MAX_BODY_MB=25                 # largest request (document upload) accepted
