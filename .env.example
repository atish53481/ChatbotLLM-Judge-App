# Copy to .env and fill in. .env is git-ignored.
# Key for the judge model's OpenAI-compatible API (a Groq key works with the defaults
# below; for a Command Code key set JUDGE_BASE_URL=https://api.commandcode.ai/provider/v1;
# for an NVIDIA nvapi- key set JUDGE_BASE_URL=https://integrate.api.nvidia.com/v1 and
# JUDGE_MODEL=openai/gpt-oss-20b).
JUDGE_API_KEY=
# Optional overrides:
# JUDGE_MODEL=openai/gpt-oss-120b
# JUDGE_BASE_URL=https://api.groq.com/openai/v1
# JUDGE_DB_PATH=judge.db
# Production settings:
# JUDGE_LOG_LEVEL=INFO                 # DEBUG, INFO, WARNING or ERROR (paths and status codes only, never bodies)
# JUDGE_AUTO_UPDATE=1                  # each start upgrades packages to the newest versions requirements.txt allows, smoke-tests them and rolls back on failure (0 = off)
# JUDGE_LOG_TRAFFIC=1                 # backend window shows each chatbot question/reply and judge call (0 = off; never headers or keys)
# JUDGE_TRAFFIC_FILE=logs/traffic-YYYY-MM-DD.log  # same lines also go to this file (watch-traffic.bat reads it); empty = no file
# JUDGE_MAX_BODY_MB=25                 # largest request (document upload) accepted
# JUDGE_CONCURRENCY=4                 # cases scored at once per metric run (1 = one at a time; lower it if the judge hits rate limits)
# JUDGE_METRIC_CONCURRENCY=2          # metrics of one run going side by side (they share the JUDGE_CONCURRENCY case slots; 1 = one after another)
